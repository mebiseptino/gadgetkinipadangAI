<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Coding Minang - Gadget Kini Padang</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif}
:root{--merah:#7B1113;--emas:#D4AF37;--hitam:#121212;--krem:#FFF8E7}
body{background:var(--hitam);color:#fff}
.songket{height:12px;background:repeating-linear-gradient(45deg,var(--emas) 0 15px,var(--merah) 15px 30px,#000 30px 45px,var(--emas) 45px 50px)}
header{background:linear-gradient(rgba(0,0,0,.85),rgba(123,17,19,.9)),url('https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=1600') center/cover;padding:20px 5% 70px;text-align:center;position:relative}
nav{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:15px}
.logo{font-family:'Playfair Display';font-size:28px;color:var(--emas)}
.logo span{color:#fff}
nav a{color:#fff;text-decoration:none;margin-left:18px;font-size:14px}
.btn{background:var(--emas);color:#000;padding:11px 22px;border:none;border-radius:30px;font-weight:700;cursor:pointer}
.btn:hover{background:#fff}
.gonjong{font-size:55px;letter-spacing:-8px;color:var(--emas);margin-top:30px}
h1{font-family:'Playfair Display';font-size:clamp(36px,6vw,64px);line-height:1.05}
h1 span{color:var(--emas)}
.hero p{max-width:700px;margin:18px auto;color:#ddd}
section{padding:60px 5%}
.judul{text-align:center;margin-bottom:30px}
.judul h2{font-family:'Playfair Display';font-size:36px;color:var(--emas)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:25px}
@media(max-width:850px){.grid{grid-template-columns:1fr}}
.card{background:#1d1d1d;border:1px solid #333;border-top:4px solid var(--emas);border-radius:18px;padding:22px;overflow:hidden}
.chat{height:380px;overflow-y:auto;background:#0a0a0a;padding:15px;border-radius:12px;margin-bottom:12px}
.msg{padding:12px 15px;border-radius:15px;margin:10px 0;max-width:88%;white-space:pre-wrap;font-size:14px;line-height:1.6}
.user{background:var(--merah);margin-left:auto}
.ai{background:#2a2a2a;border-left:4px solid var(--emas)}
.inputbox{display:flex;gap:8px}
input,select,textarea{background:#111;color:#fff;border:1px solid #444;border-radius:10px;padding:12px;width:100%}
textarea{height:280px;font-family:monospace;color:#7CFC00;resize:vertical}
iframe{width:100%;height:280px;background:#fff;border-radius:10px;border:none}
.chip{background:#333;color:var(--emas);border:1px solid var(--emas);padding:7px 12px;border-radius:20px;cursor:pointer;margin:4px;font-size:12px}
.products{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px}
.product{background:#fff;color:#111;border-radius:16px;overflow:hidden}
.product img{width:100%;height:170px;object-fit:cover}
.product div{padding:16px}
.harga{color:var(--merah);font-weight:800;font-size:18px}
footer{background:var(--merah);text-align:center;padding:35px 5%}
.filosofi{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;text-align:center}
.filosofi div{background:#1d1d1d;padding:22px;border-radius:15px;border-bottom:4px solid var(--emas)}
</style>
</head>
<body>
<div class="songket"></div>
<header>
<nav>
<div class="logo">🏠 CODING<span>MINANG</span></div>
<div><a href="#ai">AI Uda</a><a href="#playground">Playground</a><a href="#gadget">Gadget Padang</a><a href="#filosofi">Filosofi</a></div>
</nav>
<div class="gonjong">∧∧∧∧∧</div>
<div class="hero">
<h1>BARAJA CODING<br><span>DARI RANAH MINANG</span></h1>
<p><i>"Alam Takambang Jadi Guru"</i> — Baraja teknologi, gadget terkini di Padang, jo bantuan AI nan siap manolong dunsanak 24 jam.</p>
<br><button class="btn" onclick="document.getElementById('ai').scrollIntoView()">🤖 Tanyo AI Uda Kini →</button>
</div>
</header>

<section id="ai">
<div class="judul"><h2>🤖 AI UDA CODING</h2><p>Model AI Langsung Bakarajo - Tanyo Coding & Gadget</p></div>
<div class="grid">
<div class="card">
<div class="chat" id="chat">
<div class="msg ai">Halo Dunsanak! 👋 Ambo Uda AI dari Padang. Ambo bisa bantu:
• Buek Website HTML / JavaScript / Python
• Rekomendasi HP & Laptop di Padang
• Buek Pantun Minang
Cubolah klik contoh di bawah atau ketik pertanyaan!</div>
</div>
<div>
<button class="chip" onclick="tanyaOtomatis('Buatkan website toko rendang')">Website Toko Rendang</button>
<button class="chip" onclick="tanyaOtomatis('Rekomendasi laptop coding 10 juta di Padang')">Laptop Coding 10jt</button>
<button class="chip" onclick="tanyaOtomatis('Belajar Python dasar')">Belajar Python</button>
<button class="chip" onclick="tanyaOtomatis('Buatkan pantun coding minang')">Pantun Minang</button>
</div><br>
<div class="inputbox"><input id="inputAI" placeholder="Contoh: buatkan kode javascript kalkulator..."><button class="btn" onclick="kirimAI()">Kirim</button></div>
</div>

<div class="card" id="playground">
<h3 style="color:var(--emas)">💻 LIVE CODE PLAYGROUND</h3><br>
<textarea id="editor"><!DOCTYPE html>
<html><body style="font-family:sans-serif;text-align:center;background:#FFF8E7">
<h1 style="color:#7B1113">Samba Lado Digital 🍛</h1>
<p>Website partamo ambo dari Padang!</p>
<button onclick="alert('Mantap Dunsanak!')" style="background:#D4AF37;padding:12px 20px;border:none;border-radius:20px;font-weight:bold">Klik Ambo</button>
</body></html></textarea><br><br>
<button class="btn" onclick="jalankanKode()">▶ Jalankan Kode</button><br><br>
<iframe id="preview"></iframe>
</div>
</div>
</section>

<section id="gadget" style="background:var(--krem);color:#111">
<div class="judul"><h2>📱 GADGET KINI PADANG</h2><p>Update Toko Plaza Andalas • Basko Grand Mall • Damar Plaza</p></div>
<div style="text-align:center;margin-bottom:20px">
<button class="chip" onclick="filterGadget('semua')">Semua</button>
<button class="chip" onclick="filterGadget('hp')">HP</button>
<button class="chip" onclick="filterGadget('laptop')">Laptop Coding</button>
</div>
<div class="products" id="products"></div>
<h3 style="text-align:center;margin-top:25px">🛒 Keranjang: <span id="cart">0</span> item | Total: Rp <span id="total">0</span></h3>
</section>

<section id="filosofi">
<div class="judul"><h2>🏠 Filosofi Minangkabau</h2></div>
<div class="filosofi">
<div><h3>🌿 Alam Takambang</h3><p>Baraja dari alam & teknologi taruih bakambang.</p></div>
<div><h3>🤝 Basamo Mangko Manjadi</h3><p>Coding basamo komunitas, saliang mambantu.</p></div>
<div><h3>🚀 Marantau</h3><p>Skill coding mambaok dunsanak sukses dimano sajo.</p></div>
<div><h3>⚖️ Adat Basandi Syarak</h3><p>Teknologi canggih tatap manjago nilai luhur.</p></div>
</div>
</section>

<footer><h3>CODING MINANG - PADANG</h3><p>"Di mano bumi dipijak, di sinan langik dijunjuang, di sinan pulo kode ditulih."</p><p>© 2026 Gadget Kini Padang</p></footer>
<div class="songket"></div>

<script>
const chat=document.getElementById('chat');
function tambah(teks,kelas){chat.innerHTML+=`<div class="msg ${kelas}">${teks}</div>`;chat.scrollTop=chat.scrollHeight}
function tanyaOtomatis(t){document.getElementById('inputAI').value=t;kirimAI()}
function kirimAI(){
 let q=document.getElementById('inputAI').value; if(!q)return;
 tambah(q,'user'); document.getElementById('inputAI').value='';
 let l=q.toLowerCase(), jawab="";
 if(l.includes('python')) jawab="🐍 PYTHON DASAR:\n\nnama = 'Uda Minang'\nkota = 'Padang'\nprint(f'Halo {nama} dari {kota}!')\n\nfor i in range(1,6):\n    print('Baraja hari ka-', i)\n\n👉 Cubo di Playground atau Google Colab dunsanak!";
 else if(l.includes('rendang')||l.includes('website')||l.includes('html')) jawab="🌐 KODE WEBSITE TOKO RENDANG:\n\n<h1>Rendang Uni Padang</h1>\n<p>Rendang Asli Minang - Rp 85.000</p>\n<button>Bali Sekarang</button>\n\nAmbo alah masuakan contohnyo ka Playground di sampiang. Klik 'Jalankan Kode'!";
 else if(l.includes('javascript')||l.includes('kalkulator')) jawab="⚡ JAVASCRIPT KALKULATOR:\n\nlet a=10, b=5;\nconsole.log('Tambah:',a+b);\nconsole.log('Kali:',a*b);\n\nfunction sapa(nama){\n return 'Halo '+nama+' dari Padang!';\n}\nconsole.log(sapa('Uni'))";
 else if(l.includes('laptop')) jawab="💻 REKOMENDASI LAPTOP CODING DI PADANG (Budget ~10 Juta):\n\n1. Lenovo IdeaPad Slim 5 - Rp 9.8jt @ Plaza Andalas\n   Ryzen 5, RAM 16GB, SSD 512GB ✅ Terbaik Coding\n2. ASUS Vivobook 14 - Rp 8.9jt @ Damar Plaza\n3. MacBook Air M1 Second - Rp 9.5jt @ Basko\n\nSaran Uda: Ambiak RAM 16GB supayo VS Code lancar!";
 else if(l.includes('hp')||l.includes('gadget')) jawab="📱 HP TERKINI DI PADANG:\n\n• Xiaomi Redmi Note 13 Pro - Rp 3.9jt\n• Samsung Galaxy A55 - Rp 5.9jt\n• iPhone 15 - Rp 13.9jt\n\nSadonyo ado di katalog Gadget Kini di bawah. Klik Bali untuak masuak keranjang!";
 else if(l.includes('pantun')) jawab="🎤 PANTUN MINANG CODING:\n\nKa Padang mambali rendang,\nSinggah sabanta di Jam Gadang.\nKalau baraja coding pantang manyarah,\nSukses marantau ka nagari urang! 🚀";
 else jawab="Mantap pertanyaan dunsanak! 👍\n\nAmbo bisa bantu:\n• Ketik 'Python' untuak baraja Python\n• Ketik 'Website' untuak kode HTML\n• Ketik 'Laptop / HP' untuak rekomendasi Gadget Padang\n• Ketik 'Pantun' untuak hiburan\n\nAlam Takambang Jadi Guru - taruih baraja!";
 setTimeout(()=>tambah(jawab,'ai'),600);
}
document.getElementById('inputAI').addEventListener('keypress',e=>{if(e.key==='Enter')kirimAI()});
function jalankanKode(){document.getElementById('preview').srcdoc=document.getElementById('editor').value}
jalankanKode();

const data=[
{nama:"iPhone 15 128GB",kat:"hp",harga:13900000,toko:"iBox Basko Padang",img:"https://images.unsplash.com/photo-1695048133142-1a20484d2569?w=600"},
{nama:"Samsung Galaxy A55",kat:"hp",harga:5999000,toko:"Samsung Plaza Andalas",img:"https://images.unsplash.com/photo-1610945415295-d9bbf067e59c?w=600"},
{nama:"Xiaomi Redmi Note 13 Pro",kat:"hp",harga:3999000,toko:"Mi Store Damar Plaza",img:"https://images.unsplash.com/photo-1598327105666-5b89351aff97?w=600"},
{nama:"Lenovo IdeaPad Slim 5 Ryzen 5",kat:"laptop",harga:9899000,toko:"Lenovo Plaza Andalas",img:"https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=600"},
{nama:"ASUS ROG Strix Gaming",kat:"laptop",harga:15999000,toko:"ASUS Basko Grand Mall",img:"https://images.unsplash.com/photo-1603302576837-37561b2e2302?w=600"},
{nama:"MacBook Air M2",kat:"laptop",harga:16999000,toko:"iBox Padang",img:"https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=600"},
];
let cart=0,total=0;
function tampil(list){
 document.getElementById('products').innerHTML=list.map(p=>`
 <div class="product"><img src="${p.img}"><div>
 <small style="color:#7B1113;font-weight:bold">${p.toko}</small>
 <h3>${p.nama}</h3><p class="harga">Rp ${p.harga.toLocaleString('id-ID')}</p>
 <button class="btn" style="width:100%;margin-top:10px" onclick="beli(${p.harga})">🛒 Bali Kini</button>
 </div></div>`).join('');
}
function filterGadget(k){tampil(k==='semua'?data:data.filter(p=>p.kat===k))}
function beli(h){cart++;total+=h;document.getElementById('cart').innerText=cart;document.getElementById('total').innerText=total.toLocaleString('id-ID');alert('Ditambahkan ka keranjang! Tarimo kasih dunsanak 🙏')}
tampil(data);
</script>
</body>
</html>
